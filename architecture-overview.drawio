    <mxCell id="content" value="&lt;b&gt;Content script + scraper.ts&lt;/b&gt;&lt;br&gt;Injected into the Amazon tab.&lt;br&gt;Reads the page DOM: ASIN, title,&lt;br&gt;bullets, reviews, main image." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
