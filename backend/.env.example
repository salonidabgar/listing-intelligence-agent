# Copy to .env.local for `vercel dev`, and add these in the Vercel dashboard for prod.
# NOTE: put real keys in .env.local (gitignored), never in this file.
ANTHROPIC_API_KEY=sk-ant-...
# Only for an organization-level key (error "not scoped to a workspace"): Console → Settings → Workspaces → ID
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
GEMINI_API_KEY=...

# ---- Jev-orchestrated fleet (lib/fleet) ----
# off (default) = legacy fixed fan-out · shadow = tree runs, Jev answers are logged but
# the legacy path is followed · live = Jev routes lenses, gates, rubric and approval.
FLEET_MODE=shadow
# Jev decision model. Free key: https://jev-agent.com/api/auth (then set JEV_BASE_URL below).
# TypeSafe key: https://console.typesafe.ai (default base URL https://api.typesafe.ai/v1/systemone).
JEV_API_KEY=
# JEV_BASE_URL=https://jev-agent.com/api/v1/systemone
# Pinned: aliases move (jev-latest → 1.14 since Oct 2026) and thresholds are tuned per version.
JEV_MODEL=jev-1.13.0
# FLEET_JEV=http|heuristic|claude   (default: http when JEV_API_KEY is set, else heuristic stand-in)
# FLEET_AGENTS=claude|mock           (mock = no Claude spend; for demos)
# FLEET_ROUTER_MODEL=claude-opus-5-5 (only for FLEET_JEV=claude, the Claude-as-router baseline)
# FLEET_LOG_DIR=.jev/runs            (JSONL event log per run; feeds npm run fleet:calibrate)
